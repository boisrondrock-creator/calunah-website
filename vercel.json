{
  "functions": {
    "api/publish.js": { "runtime": "nodejs20.x" },
    "api/upload.js":  { "runtime": "nodejs20.x" }
  },
  "rewrites": [
    { "source": "/admin",  "destination": "/admin/index.html" },
    { "source": "/admin/", "destination": "/admin/index.html" }
  ],
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
